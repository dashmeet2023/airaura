# MongoDB connection string (local or MongoDB Atlas SRV URI ending with /airaura)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/airaura?retryWrites=true&w=majority
# Target MongoDB database name
DB_NAME=airaura
# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-64-char-random-hex-secret
# Shared X-Node-Key secret expected from hardware node airaura-01
NODE_API_KEY=replace-with-random-node-key
# Comma-separated allowed browser origins (no trailing slash, e.g. https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:3000
# Runtime environment: development or production (skips sample seeds & default passwords in production)
ENV=development
# Email for the seeded pcb_official administrator account
ADMIN_EMAIL=admin@ppcb.gov.in
# Strong password for the seeded pcb_official administrator account (required non-default in production)
ADMIN_PASSWORD=replace-with-strong-admin-password
# Email for the seeded demo student account
STUDENT_DEMO_EMAIL=student@thapar.edu
# Password for the seeded demo student account (optional; skipped in production if unset)
STUDENT_DEMO_PASSWORD=replace-with-demo-student-password
